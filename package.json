{
  "name": "christmas-2026",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "trap 'docker compose down' EXIT INT TERM; docker compose up -d --wait redis && next dev",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint",
    "start": "next start",
    "test:e2e": "if [ -z \"$(docker ps -q -f 'name=^/redis$' -f 'status=running')\" ]; then trap 'docker compose down' EXIT INT TERM; docker compose up -d --wait redis; fi && playwright test",
    "test:watch": "vitest",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.4",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@ts-morph/common": {
      "minimatch": "^11.0.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
